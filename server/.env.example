# Development settings for the API. Copy to server/.env and run from server/:
#   go run ./cmd/http
# A variable already set in the shell wins over this file. In production these come from the
# repo root's .env through docker compose instead.

PORT=8080

# The Daftar form goes to this Telegram chat; empty token or chat: the form answers 503.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shown as [LOCAL] on each message, so test submissions stand out; empty in production
INQUIRY_ENV_TAG=local

# The "server bersama" numbers: the shared server's IDCloudHost billing account. The key can also
# change the account (IDCloudHost has no read-only key). Empty key or account: the numbers answer 503.
IDCLOUDHOST_API_KEY=
IDCLOUDHOST_BILLING_ACCOUNT_ID=
# The shared server's VMs, comma separated (their name in IDCloudHost): only their resources count
# toward the monthly cost, in case the billing account also pays for other projects. Empty: all.
TRANSPARENCY_VM_NAMES=
# Kept by hand: rupiah held for the server but not topped up to IDCloudHost yet
TRANSPARENCY_EXTRA_DEPOSIT=0
# How long one IDCloudHost answer is reused. Empty: 1h.
TRANSPARENCY_CACHE_TTL=
