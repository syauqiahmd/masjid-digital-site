# Copy to .env and adjust. Only this example is committed.

# The demo of the admin panel behind every "Coba demo" button. Leave empty to hide them.
# Locally: the admin app's dev server (cd web && npm run dev). In production: the demo's URL.
VITE_DEMO_URL=http://localhost:5173
# The demo TV display, shown under "Layar TV" in Coba demo. Empty: the demo URL + /tv.
VITE_DEMO_TV_URL=
# The demo's login, shown with copy buttons next to the demo (the panel runs on its own domain, so
# the page cannot fill its form). Public to every visitor: use an account made for the demo.
# Empty: the box is hidden.
VITE_DEMO_PHONE=
VITE_DEMO_PASSWORD=
# Where the "Daftar" form posts. Empty: /api/public/v1/inquiries on this site's origin, which the
# dev server forwards to VITE_API_PROXY_TARGET.
VITE_INQUIRY_URL=
# Where the "server bersama" numbers are read. Empty: /api/public/v1/transparency on this site's
# origin, forwarded like the form.
VITE_TRANSPARENCY_URL=
# The site's public address for search engines: canonical links, the share image, sitemap.xml.
# Empty: https://masjidyuk.com. Set it only for another deploy, e.g. staging.
VITE_SITE_URL=
# Google Search Console's HTML tag verification: only the content="..." value. Empty: no tag.
VITE_GOOGLE_SITE_VERIFICATION=
# The API the dev server forwards /api to (cd server && go run ./cmd/http). Empty: http://localhost:8080.
VITE_API_PROXY_TARGET=

# Deploy only (docker compose, see deploy/README.md); the dev server ignores them.
# The Docker network shared with the reverse proxy. Empty: proxy.
PROXY_NETWORK=

# The API (server/, the api container). Secrets: only in .env on the server, never committed.
# The Daftar form goes to this Telegram chat; empty token or chat: the form answers 503.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# e.g. local or staging, shown as [LOCAL] on each message; empty in production
INQUIRY_ENV_TAG=
# The "server bersama" numbers: the shared server's IDCloudHost billing account. The key can also
# change the account (IDCloudHost has no read-only key). Empty key or account: the numbers answer 503.
IDCLOUDHOST_API_KEY=
IDCLOUDHOST_BILLING_ACCOUNT_ID=
# The shared server's VMs, comma separated, e.g. masjidyuk. Empty: every VM of the account.
TRANSPARENCY_VM_NAMES=
# Kept by hand: rupiah held for the server but not topped up to IDCloudHost yet
TRANSPARENCY_EXTRA_DEPOSIT=0
# How long one IDCloudHost answer is reused. Empty: 1h.
TRANSPARENCY_CACHE_TTL=
